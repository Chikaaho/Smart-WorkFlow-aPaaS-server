<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sw.ck</groupId>
        <artifactId>smart-workflow</artifactId>
        <version>${revision}</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>sw-bpm-process</artifactId>
    <packaging>jar</packaging>

    <name>Smart-WorkFlow :: Biz :: BPM :: Process</name>
    <description>BPM 流程引擎模块 - 业务处理层（开源），流程编排/待办富化/表单绑定</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.sw.ck</groupId>
                <artifactId>sw-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-bpm-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-biz-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-biz-form-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 通知门面接口 -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-notify-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 存储门面接口（表单附件/图片上传与对象权限下载） -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-storage-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Phase 4 可靠业务事件：定时任务流程启动受理端口（ScheduledFlowStartPort） -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-job-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            IoT 跨模块契约（Phase 5 边界抽取）：本模块只依赖 sw-basic-iot-api，不依赖完整实现模块，
            因此不再传递获得 MQTT/Paho、GraalJS、Tencent IoT SDK 等实现依赖。
            实现模块由 sw-bootstrap 在最终装配时引入。
        -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-iot-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            fastjson2 为 Phase 5 显式化的直接依赖：本模块有 4 个生产文件直接使用
            com.alibaba.fastjson2（流程设备动作配置解析、流程模板动作 JSON、表单契约字段提取）。
            抽取 IoT 契约前它只是经 sw-basic-iot 传递获得的未声明依赖，移除传递来源会立即编译失败。
            版本已随 Phase 6A 集中进 sw-dependencies（2.0.53，与集中化前实际解析值一致），
            此处只声明坐标；不得在本模块重新写 version。
        -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- =================== 测试 =================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- G4/G5/G7 隔离集成验证：测试内按 bpm 迁移目录初始化真实 H2 schema -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
