<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sw.ck</groupId>
        <artifactId>smart-workflow</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>sw-bootstrap</artifactId>
    <packaging>jar</packaging>

    <name>Smart-WorkFlow :: Bootstrap</name>
    <description>唯一启动入口模块</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.sw.ck</groupId>
                <artifactId>sw-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- zonky embedded-postgres-binaries BOM：统一全部受支持平台（linux/darwin/windows，
                 amd64/arm64 等）的 PostgreSQL 二进制版本为 17.5.0，由 zonky 运行时按 os/arch
                 自动选择对应平台产物（FlywayFullChainPostgresTest 跨平台可运行）。 -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>17.5.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- =================== 内核层 =================== -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- =================== 基础能力层 =================== -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-storage-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-notify-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-job-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-iot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-basic-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- =================== 业务层（依赖 -biz 实现） =================== -->
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-biz-system-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-biz-openapi-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-bpm-process</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-bpm-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sw.ck</groupId>
            <artifactId>sw-biz-form-biz</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- =================== 基础启动依赖 =================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- =================== 基础运行依赖 =================== -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- =================== 后续常用基础依赖 =================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- =================== 测试依赖 =================== -->
        <!-- 版本由 sw-dependencies 引入的 spring-boot-dependencies BOM 管理，不写死版本号 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- zonky embedded-postgres：JUnit 内嵌真实 PostgreSQL 二进制，
             用于 PG 侧全链 Flyway 迁移验证（FlywayFullChainPostgresTest）。
             平台二进制版本由 dependencyManagement 中的 embedded-postgres-binaries-bom
             （17.5.0）统一管理：core 默认携带 windows-amd64/darwin-amd64/linux-amd64/
             linux-amd64-alpine 四个平台产物，darwin-arm64v8 显式补充——任一受支持
             平台（linux/darwin/windows × amd64/arm64）由 zonky 运行时按 os/arch
             自动解析对应 17.5.0 产物，不在 pom 中做平台排除。 -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bootstrap</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <jvmArguments>
                        -Dfile.encoding=UTF-8
                        -Dsun.stdout.encoding=UTF-8
                        -Dsun.stderr.encoding=UTF-8
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
